# NFC APDU Spy - pretends to be an NFC badge and logs everything a phone sends.
App(
    appid="nfc_apdu_spy",
    name="NFC Apdu Spy",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="nfc_apdu_spy_app",
    stack_size=8 * 1024,
    fap_category="NFC",
    targets=["f7"],
    fap_version="1.0.0",
    fap_icon="images/nfc_apdu_spy_10px.png",
    fap_description="Emulates an ISO14443-4A badge and logs all APDUs from a phone",
    fap_author="Menrix (Don_Key_Moustache)",
)
