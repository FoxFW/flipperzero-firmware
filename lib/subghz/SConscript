Import("env")

env.Append(
    CPPPATH=[
        "#/lib/subghz",
    ],
    LINT_SOURCES=[
        Dir("."),
    ],
    SDK_HEADERS=[
        File("environment.h"),
        File("receiver.h"),
        File("registry.h"),
        File("subghz_worker.h"),
        File("subghz_tx_rx_worker.h"),
        File("subghz_file_encoder_worker.h"),
        File("transmitter.h"),
        File("protocols/raw.h"),
        File("protocols/public_api.h"),
        File("blocks/const.h"),
        File("blocks/decoder.h"),
        File("blocks/encoder.h"),
        File("blocks/generic.h"),
        File("blocks/math.h"),
        File("blocks/custom_btn.h"),
        File("subghz_setting.h"),
        File("subghz_protocol_registry.h"),
        File("devices/cc1101_configs.h"),
        File("devices/cc1101_int/cc1101_int_interconnect.h"),
        File("devices/devices.h"),
        File("devices/registry.h"),
        File("subghz_file_encoder_worker.h"),
    ],
)

libenv = env.Clone(FW_LIB_NAME="subghz")
libenv.ApplyLibFlags()

# Windows: libsubghz archives many objects - one `ar` command exceeds cmd.exe's ~8191
# char limit. Use a response file (TEMPFILE), and invoke binutils `ar` directly instead
# of the `gcc-ar` wrapper, which forwards the @response-file to ar malformed
# ("invalid option -- @"). LTO is off for these libs, so gcc-ar's plugin is not needed.
libenv.Replace(AR="arm-none-eabi-ar")
if "TEMPFILE" not in libenv["ARCOM"]:
    libenv["ARCOM"] = '${TEMPFILE("' + libenv["ARCOM"] + '","$ARCOMSTR")}'

sources = libenv.GlobRecursive("*.c*")

lib = libenv.StaticLibrary("${FW_LIB_NAME}", sources)
libenv.Install("${LIB_DIST_DIR}", lib)
Return("lib")
