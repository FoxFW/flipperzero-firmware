App(
    appid="storage",
    name="StorageSrv",
    apptype=FlipperAppType.SERVICE,
    entry_point="storage_srv",
    cdefines=["SRV_STORAGE"],
    requires=["storage_settings"],
    provides=["cli_storage", "cli_factory_reset"],
    sources=["*.c*", "!storage_cli.c", "!storage_cli_factory_reset.c"],
    stack_size=3 * 1024,
    order=120,
    sdk_headers=["storage.h"],
)

App(
    appid="cli_storage",
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_storage_ep",
    requires=["cli"],
    sources=["storage_cli.c"],
)

App(
    appid="cli_factory_reset",
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_factory_reset_ep",
    requires=["cli"],
    sources=["storage_cli_factory_reset.c"],
)
