App(
    appid="subghz",
    name="Sub-GHz",
    apptype=FlipperAppType.APP,
    targets=["f7"],
    cdefines=["APP_SUBGHZ"],
    entry_point="subghz_app",
    sources=["*.c*", "!protocols_ext", "!config_ext"],
    requires=[
        "gui",
        "cli",
        "dialogs",
    ],
    provides=[
        "subghz_load_dangerous_settings",
    ],
    icon="I_subghz_1_14x14",
    stack_size=3 * 1024,
    order=1,
    resources="resources",
    fap_libs=["assets", "hwdrivers"],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
)

App(
    appid="cli_subghz",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_subghz_ep",
    requires=["cli"],
    sources=["subghz_cli.c", "helpers/subghz_chat.c"],
)

# === FoxFW2.0 2026-10-31: config-externalization — scene config screens as
# on-demand .fal plugins (config_ext/). Resident loader: helpers/subghz_config_scene_loader.c. ===
App(
    appid="subghz_config_dual",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_config_dual_ep",
    requires=["subghz"],
    sources=["config_ext/subghz_config_dual.c"],
)

App(
    appid="subghz_config_modulation",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_config_modulation_ep",
    requires=["subghz"],
    sources=["config_ext/subghz_config_modulation.c"],
)

App(
    appid="subghz_config_radio",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_config_radio_ep",
    requires=["subghz"],
    sources=["config_ext/subghz_config_radio.c"],
)

App(
    appid="subghz_config_receiver",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="subghz_config_receiver_ep",
    requires=["subghz"],
    sources=["config_ext/subghz_config_receiver.c"],
)

App(
    appid="subghz_load_dangerous_settings",
    apptype=FlipperAppType.STARTUP,
    entry_point="subghz_dangerous_freq",
    requires=["storage", "subghz"],
    order=650,
)

# === FoxFW2.0 v2.1 2026-10-22: no Level-2 groups. Every protocol is registered live
# (lib/subghz/protocols/protocol_items.c); only its detector is internal. Each one's
# get_string is decode_<p>.fal and its encoder enc_<p>.fal (App blocks below), loaded
# on demand from /ext/apps_data/subghz/plugins/. The old subghz_ext_auto_g1..g3 groups
# and the deep-scan scene were removed.

App(
    appid="decode_princeton",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="decode_princeton_ep",
    requires=["subghz"],
    sources=["protocols_ext/decode_princeton.c"],
)

App(
    appid="decode_g1",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="decode_g1_ep",
    requires=["subghz"],
    sources=["protocols_ext/decode_g1.c"],
)


